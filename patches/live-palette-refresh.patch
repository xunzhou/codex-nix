+#[cfg(unix)]
+pub(crate) fn refresh_default_colors_from_terminal() -> bool {
+    let Ok(probe) = crate::terminal_probe::startup(
+        crate::terminal_probe::DEFAULT_TIMEOUT,
+        crate::terminal_probe::StartupKeyboardEnhancementProbe::Skip,
+    ) else {
+        return false;
+    };
+    let Some(colors) = probe.default_colors else {
+        return false;
+    };
+    imp::set_default_colors_from_startup_probe(Some(colors));
+    true
+}
