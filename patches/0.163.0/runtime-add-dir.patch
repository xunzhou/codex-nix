+#[tokio::test]
+async fn add_dir_requires_confirmation_and_resolves_relative_paths() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(None).await;
+    let directory = tempfile::tempdir().unwrap();
+    std::fs::create_dir(directory.path().join("extra space")).unwrap();
+    chat.config.cwd = AbsolutePathBuf::from_absolute_path(directory.path().to_path_buf()).unwrap();
+    chat.thread_id = Some(ThreadId::new());
+    chat.local_worktree_operations = true;
+    chat.config
+        .permissions
+        .set_permission_profile(PermissionProfile::from_legacy_sandbox_policy_for_cwd(
+            &codex_protocol::protocol::SandboxPolicy::WorkspaceWrite {
+                writable_roots: vec![],
+                network_access: false,
+                exclude_tmpdir_env_var: true,
+                exclude_slash_tmp: true,
+            },
+            chat.config.cwd.as_path(),
+        ))
+        .unwrap();
+    chat.request_add_directory("extra space");
+    assert!(rx.try_recv().is_err());
+    assert!(op_rx.try_recv().is_err());
+    // The default selection cancels, and Escape also dismisses without a grant.
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(
+        !std::iter::from_fn(|| rx.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::AddWritableRoot { .. }))
+    );
+    chat.request_add_directory("extra space");
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    assert!(
+        !std::iter::from_fn(|| rx.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::AddWritableRoot { .. }))
+    );
+    chat.request_add_directory("extra space");
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let expected = std::fs::canonicalize(directory.path().join("extra space")).unwrap();
+    assert!(
+        std::iter::from_fn(|| rx.try_recv().ok()).any(|event| matches!(event,
+        AppEvent::AddWritableRoot { root, .. } if root.as_path() == expected))
+    );
+    assert!(op_rx.try_recv().is_err());
+}
