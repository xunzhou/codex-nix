--- /dev/null
+++ b/codex-rs/core/src/session/runtime_add_dir.rs
@@ -0,0 +1,334 @@
+//! Additive, thread-scoped workspace grants. Never replaces a permission profile.
+
+use super::session::Session;
+use super::session::SessionConfiguration;
+use super::session::SessionSettingsUpdate;
+use super::thread_settings;
+use crate::config::ConstraintError;
+use crate::config::ConstraintResult;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::permissions::FileSystemPath;
+use codex_protocol::permissions::FileSystemSpecialPath;
+use codex_protocol::permissions::is_protected_metadata_name;
+use codex_protocol::protocol::EnvironmentConfigState;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+
+fn denied(root: &AbsolutePathBuf, reason: impl std::fmt::Display) -> ConstraintError {
+    ConstraintError::InvalidValue {
+        field_name: "add_writable_root",
+        candidate: root.display().to_string(),
+        allowed: reason.to_string(),
+        requirement_source: codex_config::RequirementSource::Unknown,
+    }
+}
+
+impl SessionConfiguration {
+    pub(super) fn add_writable_root(&mut self, root: &AbsolutePathBuf) -> ConstraintResult<()> {
+        // Revalidate at commit, including the identity the user saw in the prompt.
+        let canonical = std::fs::canonicalize(root.as_path())
+            .map_err(|err| denied(root, format!("an accessible existing directory ({err})")))?;
+        if canonical != root.as_path() || !canonical.is_dir() {
+            return Err(denied(
+                root,
+                "an unchanged canonical directory; run /add-dir again",
+            ));
+        }
+        if root
+            .as_path()
+            .components()
+            .any(|part| is_protected_metadata_name(part.as_os_str()))
+        {
+            return Err(denied(root, "a directory outside protected metadata paths"));
+        }
+        if self.environments.is_empty()
+            || self.environments.iter().any(|env| {
+                env.environment_id != codex_exec_server::LOCAL_ENVIRONMENT_ID
+                    || env.config != EnvironmentConfigState::FromThread
+            })
+        {
+            return Err(denied(
+                root,
+                "a local environment with thread-owned permissions",
+            ));
+        }
+        let profile = self.permission_profile();
+        let policy = profile.file_system_sandbox_policy();
+        // An explicit profile must permit writes to workspace roots. Do not silently
+        // turn read-only or path-limited profiles into workspace-write profiles.
+        let symbolic = policy.entries.iter().any(|entry| {
+            entry.access.can_write()
+                && matches!(
+                    entry.path,
+                    FileSystemPath::Special {
+                        value: FileSystemSpecialPath::ProjectRoots { subpath: None }
+                    }
+                )
+        });
+        if !symbolic {
+            return Err(denied(
+                root,
+                "a permission profile that allows workspace-root writes",
+            ));
+        }
+        let current_policy = self.file_system_sandbox_policy(&self.environments);
+        if self.runtime_workspace_roots.contains(root) {
+            return if current_policy
+                .can_read_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+                && current_policy
+                    .can_write_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+            {
+                Ok(())
+            } else {
+                Err(denied(
+                    root,
+                    "a directory allowed by the current filesystem policy",
+                ))
+            };
+        }
+
+        for entry in &current_policy.entries {
+            if !entry.access.can_write()
+                && let FileSystemPath::Path { path } = &entry.path
+                && let Ok(path) = path.to_abs_path()
+                && root.as_path().starts_with(
+                    std::fs::canonicalize(path.as_path()).unwrap_or_else(|_| path.to_path_buf()),
+                )
+            {
+                return Err(denied(
+                    root,
+                    format!("a directory outside restricted path {}", path.display()),
+                ));
+            }
+        }
+        let mut roots = self.runtime_workspace_roots.clone();
+        roots.push(root.clone());
+        // Validate the expanded policy with existing managed-policy validators. Keep
+        // the symbolic profile, its ID, network rules, and every carveout intact.
+        let candidate = profile
+            .clone()
+            .materialize_project_roots_with_workspace_roots(&roots);
+        self.permission_profile_state
+            .can_set_legacy_permission_profile(&candidate)?;
+        let candidate_policy = candidate.file_system_sandbox_policy();
+        if !candidate_policy.can_read_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+            || !candidate_policy.can_write_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+        {
+            return Err(denied(
+                root,
+                "a directory allowed by the current filesystem policy",
+            ));
+        }
+        let uri = PathUri::from_abs_path(root);
+        for environment in &mut self.environments {
+            if !environment.workspace_roots.contains(&uri) {
+                environment.workspace_roots.push(uri.clone());
+            }
+        }
+        self.runtime_workspace_roots = roots;
+        self.session_granted_roots.push(root.clone());
+        Ok(())
+    }
+}
+
+impl Session {
+    pub(crate) async fn add_writable_root(&self, root: AbsolutePathBuf) -> CodexResult<()> {
+        let _guard = thread_settings::acquire_persistence_lock(self).await;
+        let commit = self
+            .update_settings(SessionSettingsUpdate {
+                add_writable_root: Some(root),
+                ..Default::default()
+            })
+            .await
+            .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+        // Grant roots are omitted from every persistent checkpoint. The event still
+        // refreshes live client settings; the next turn captures the updated roots.
+        thread_settings::emit_applied(self, super::new_submission_id(), commit.snapshot).await;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+    use crate::config::PermissionProfileState;
+    use codex_config::Constrained;
+    use codex_protocol::models::PermissionProfile;
+    use codex_protocol::permissions::FileSystemAccessMode;
+    use codex_protocol::permissions::FileSystemSandboxEntry;
+    use codex_protocol::protocol::TurnEnvironmentRequest;
+    use codex_protocol::protocol::TurnEnvironmentSelection;
+
+    async fn configuration() -> SessionConfiguration {
+        let mut config = super::super::tests::make_session_configuration_for_tests().await;
+        config.permission_profile_state = PermissionProfileState::from_constrained_legacy(
+            Constrained::allow_any(PermissionProfile::workspace_write_with(
+                &[],
+                codex_protocol::permissions::NetworkSandboxPolicy::Restricted,
+                true,
+                true,
+            )),
+        )
+        .unwrap();
+        config.environments = vec![TurnEnvironmentSelection::new(
+            TurnEnvironmentRequest {
+                environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+                cwd: PathUri::from_abs_path(config.cwd()),
+                workspace_roots: config
+                    .runtime_workspace_roots
+                    .iter()
+                    .map(PathUri::from_abs_path)
+                    .collect(),
+                config: EnvironmentConfigState::FromThread,
+            },
+            &[],
+        )];
+        config
+    }
+
+    #[tokio::test]
+    async fn add_dir_grant_preserves_profile_and_enforces_protected_paths() {
+        let directory = tempfile::tempdir().unwrap();
+        let root =
+            AbsolutePathBuf::from_absolute_path(std::fs::canonicalize(directory.path()).unwrap())
+                .unwrap();
+        std::fs::create_dir(root.join(".git")).unwrap();
+        let mut config = configuration().await;
+        assert!(
+            !config
+                .file_system_sandbox_policy(&config.environments)
+                .can_write_local_path_with_cwd(root.as_path(), config.cwd().as_path())
+        );
+        let original = config.permission_profile_state.clone();
+        let previous = config.runtime_workspace_roots.clone();
+        config.add_writable_root(&root).unwrap();
+        assert_eq!(config.permission_profile_state, original);
+        assert!(
+            previous
+                .iter()
+                .all(|path| config.runtime_workspace_roots.contains(path))
+        );
+        let policy = config.file_system_sandbox_policy(&config.environments);
+        assert!(
+            policy.can_write_local_path_with_cwd(
+                root.join("new.txt").as_path(),
+                config.cwd().as_path()
+            )
+        );
+        for name in [".git", ".agents", ".codex", ".aws"] {
+            assert!(
+                !policy.can_write_local_path_with_cwd(
+                    root.join(name).as_path(),
+                    config.cwd().as_path()
+                ),
+                "{name}"
+            );
+        }
+        let outside = tempfile::tempdir().unwrap();
+        assert!(!policy.can_write_local_path_with_cwd(outside.path(), config.cwd().as_path()));
+        let count = config.runtime_workspace_roots.len();
+        config.add_writable_root(&root).unwrap();
+        assert_eq!(config.runtime_workspace_roots.len(), count);
+        let protected = root.join(".git");
+        assert!(config.add_writable_root(&protected).is_err());
+        assert!(
+            config
+                .thread_settings_snapshot(&config.environments)
+                .runtime_workspace_roots
+                .unwrap()
+                .contains(&root)
+        );
+        let snapshot = config.persisted_thread_settings_snapshot(&config.environments);
+        assert!(!snapshot.runtime_workspace_roots.unwrap().contains(&root));
+        assert!(
+            !snapshot
+                .permission_profile
+                .file_system_sandbox_policy()
+                .can_write_local_path_with_cwd(root.as_path(), config.cwd().as_path())
+        );
+        let saved = config.restorable_thread_settings(config.environments.clone());
+        assert!(!saved.runtime_workspace_roots.unwrap().contains(&root));
+        assert!(
+            !saved.environments.unwrap().environment_requests[0]
+                .workspace_roots
+                .contains(&PathUri::from_abs_path(&root))
+        );
+    }
+
+    #[tokio::test]
+    async fn add_dir_grant_rejects_managed_constraints_atomically() {
+        let directory = tempfile::tempdir().unwrap();
+        let root =
+            AbsolutePathBuf::from_absolute_path(std::fs::canonicalize(directory.path()).unwrap())
+                .unwrap();
+        let mut config = configuration().await;
+        // A managed constraint on the materialized candidate rejects expansion.
+        config.permission_profile_state = PermissionProfileState::from_constrained_legacy(
+            Constrained::allow_only(config.permission_profile()),
+        )
+        .unwrap();
+        let previous_roots = config.runtime_workspace_roots.clone();
+        let previous_environments = config.environments.clone();
+        assert!(config.add_writable_root(&root).is_err());
+        assert_eq!(config.runtime_workspace_roots, previous_roots);
+        assert_eq!(config.environments, previous_environments);
+        config.permission_profile_state = PermissionProfileState::from_constrained_legacy(
+            Constrained::allow_only(PermissionProfile::read_only()),
+        )
+        .unwrap();
+        assert!(config.add_writable_root(&root).is_err());
+        let existing_root = config.runtime_workspace_roots[0].clone();
+        assert!(config.add_writable_root(&existing_root).is_err());
+    }
+
+    #[tokio::test]
+    async fn add_dir_grant_preserves_denials_and_rejects_invalid_or_remote_paths() {
+        let directory = tempfile::tempdir().unwrap();
+        let root =
+            AbsolutePathBuf::from_absolute_path(std::fs::canonicalize(directory.path()).unwrap())
+                .unwrap();
+        let blocked = root.join("private");
+        std::fs::create_dir(&blocked).unwrap();
+        let mut config = configuration().await;
+        let profile = config.permission_profile();
+        let mut fs = profile.file_system_sandbox_policy();
+        fs.entries.push(FileSystemSandboxEntry::new(
+            blocked.clone().into(),
+            FileSystemAccessMode::Deny,
+        ));
+        config
+            .permission_profile_state
+            .set_legacy_permission_profile(
+                PermissionProfile::from_runtime_permissions_with_enforcement(
+                    profile.enforcement(),
+                    &fs,
+                    profile.network_sandbox_policy(),
+                ),
+            )
+            .unwrap();
+        assert!(config.add_writable_root(&blocked).is_err());
+        config.add_writable_root(&root).unwrap();
+        let policy = config.file_system_sandbox_policy(&config.environments);
+        assert!(!policy.can_read_local_path_with_cwd(blocked.as_path(), config.cwd().as_path()));
+        assert!(!policy.can_write_local_path_with_cwd(blocked.as_path(), config.cwd().as_path()));
+        assert!(config.add_writable_root(&root.join("missing")).is_err());
+        let file = root.join("file");
+        std::fs::write(&file, "test").unwrap();
+        assert!(config.add_writable_root(&file).is_err());
+        config.environments[0].environment_id = "remote".to_string();
+        assert!(config.add_writable_root(&root).is_err());
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn add_dir_grant_rejects_changed_symlink_identity() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = AbsolutePathBuf::from_absolute_path(directory.path().to_path_buf()).unwrap();
+        let link = root.join("link");
+        std::os::unix::fs::symlink(directory.path(), link.as_path()).unwrap();
+        let mut config = configuration().await;
+        assert!(config.add_writable_root(&link).is_err());
+    }
+}
