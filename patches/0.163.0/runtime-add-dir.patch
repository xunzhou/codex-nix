+#[tokio::test]
+async fn add_dir_grant_cannot_bypass_managed_read_only_policy() -> Result<()> {
+    let model = create_mock_responses_server_sequence_unchecked(Vec::new()).await;
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), &model.uri())?;
+    std::fs::write(
+        home.path().join("requirements.toml"),
+        "allowed_sandbox_modes = [\"read-only\"]\n",
+    )?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = mcp
+        .start_thread(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            sandbox: Some(SandboxMode::ReadOnly),
+            ..Default::default()
+        })
+        .await?;
+    let directory = TempDir::new()?;
+    let root = std::fs::canonicalize(directory.path())?;
+    for fields in [
+        json!({"threadId": started.thread.id, "addWritableRoot": root}),
+        json!({"threadId": started.thread.id, "addWritableRoot": root, "permissions": ":workspace"}),
+    ] {
+        let request = mcp
+            .send_raw_request("thread/settings/update", Some(fields))
+            .await?;
+        let error = timeout(
+            DEFAULT_TIMEOUT,
+            mcp.read_stream_until_error_message(RequestId::Integer(request)),
+        )
+        .await??;
+        assert!(
+            error.error.message.contains("Directory grant error")
+                || error.error.message.contains("cannot be combined")
+        );
+    }
+    assert!(matches!(started.sandbox, SandboxPolicy::ReadOnly { .. }));
+    assert!(received_response_bodies(&model).await?.is_empty());
+    Ok(())
+}
