+#[tokio::test]
+#[cfg(unix)]
+async fn external_editor_reference_failure_and_malformed_buffers_are_retained() {
+    for command in [
+        "printf 'recoverable edits' >> \"$1\"; exit 1",
+        "printf 'recoverable edits' > \"$1\"",
+        "printf 'recoverable edits' >> \"$1\"; kill -TERM $$",
+    ] {
+        let paths = EditorPaths::new();
+        let cmd = vec!["sh".into(), "-c".into(), command.into(), "editor".into()];
+        let error = super::run_editor_with_reference(
+            "original draft",
+            Some("Which color?"),
+            &cmd,
+            &paths.codex_home,
+            &FileSystemSandboxPolicy::read_only(),
+            &paths.cwd,
+        )
+        .await
+        .unwrap_err()
+        .to_string();
+        let retained = fs::read_dir(paths.codex_home.join("editor"))
+            .unwrap()
+            .map(|entry| entry.unwrap().path())
+            .collect::<Vec<_>>();
+        assert_eq!(retained.len(), 1);
+        assert!(error.contains("composer left unchanged"));
+        assert!(error.contains(retained[0].to_str().unwrap()));
+        assert!(
+            fs::read_to_string(&retained[0])
+                .unwrap()
+                .contains("recoverable edits")
+        );
+    }
+}
