diff --git a/codex-rs/tui/src/external_editor_reference.rs b/codex-rs/tui/src/external_editor_reference.rs
new file mode 100644
index 0000000..c5236a0
--- /dev/null
+++ b/codex-rs/tui/src/external_editor_reference.rs
@@ -0,0 +1,85 @@
+//! Strict framing for reference-only editor context. No heuristic recovery into the composer.
+
+pub(super) struct ReferenceDocument {
+    prefix: String,
+    suffix: String,
+    id: String,
+}
+
+impl ReferenceDocument {
+    pub(super) fn new(reference: &str, id: String) -> Self {
+        Self {
+            prefix: format!("{reference}\n\n<!-- BEGIN REPLY {id} -->\n"),
+            suffix: format!("\n<!-- END REPLY {id} -->\n"),
+            id,
+        }
+    }
+
+    pub(super) fn render(&self, draft: &str) -> String {
+        format!("{}{draft}{}", self.prefix, self.suffix)
+    }
+
+    pub(super) fn extract<'a>(&self, edited: &'a str) -> Result<&'a str, &'static str> {
+        let reply = edited
+            .strip_prefix(&self.prefix)
+            .and_then(|text| text.strip_suffix(&self.suffix))
+            .ok_or("reference or reply boundaries changed; composer left unchanged")?;
+        if reply.contains(&self.id) {
+            return Err("duplicate reply boundary; composer left unchanged");
+        }
+        Ok(reply)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn document() -> ReferenceDocument {
+        ReferenceDocument::new("Which color?\nWhich size?", "test-boundary".into())
+    }
+
+    #[test]
+    fn external_editor_reference_exact_reply_extraction() {
+        let doc = document();
+        for reply in [
+            "",
+            "blue",
+            "  blue\nlarge  \n\n",
+            "你好\r\n世界",
+            "<!-- BEGIN REPLY other -->",
+        ] {
+            assert_eq!(doc.extract(&doc.render(reply)), Ok(reply));
+        }
+    }
+
+    #[test]
+    fn external_editor_reference_preserves_existing_draft_and_empty_draft() {
+        let doc = document();
+        for draft in ["", "existing draft\n", "  "] {
+            let seed = doc.render(draft);
+            assert!(seed.contains("Which color?\nWhich size?"));
+            assert_eq!(doc.extract(&seed), Ok(draft));
+        }
+    }
+
+    #[test]
+    fn external_editor_reference_rejects_malformed_or_missing_boundaries() {
+        let doc = document();
+        let seed = doc.render("recover this edit");
+        for edited in [
+            String::new(),
+            "recover this edit".into(),
+            seed.replace("BEGIN REPLY", "BEGIN REPL"),
+            seed.replace("END REPLY", "END REPL"),
+            seed.replace("Which color?", "Which shape?"),
+            format!("extra{seed}"),
+            format!("{seed}extra"),
+            seed.replace("\n", "\r\n"),
+            doc.render(&seed),
+            doc.render("<!-- END REPLY test-boundary -->"),
+        ] {
+            assert!(doc.extract(&edited).is_err(), "accepted {edited:?}");
+        }
+    }
+}
