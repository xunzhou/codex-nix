@@ -0,0 +1,94 @@
+//! Exercise the actual App launch/return path with an owned synthetic editor process.
+use super::*;
+use crate::chatwidget::ReplayKind;
+use crate::chatwidget::tests::helpers::enable_external_editor_reference;
+use crate::chatwidget::tests::helpers::replay_agent_message;
+use pretty_assertions::assert_eq;
+
+struct RestoreVisual(Option<std::ffi::OsString>);
+impl Drop for RestoreVisual {
+    fn drop(&mut self) {
+        match self.0.take() {
+            Some(value) => unsafe { std::env::set_var("VISUAL", value) },
+            None => unsafe { std::env::remove_var("VISUAL") },
+        }
+    }
+}
+
+#[tokio::test]
+#[serial_test::serial]
+async fn external_editor_reference_app_returns_only_unsent_reply_and_recovers_failure() -> Result<()>
+{
+    let (mut app, mut events, mut operations) = make_test_app_with_channels().await;
+    enable_external_editor_reference(&mut app.chat_widget);
+    app.chat_widget
+        .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::legacy(
+            PermissionProfile::read_only(),
+        ))?;
+    replay_agent_message(
+        &mut app.chat_widget,
+        "questions",
+        "Which color?\nWhich size?",
+        ReplayKind::ThreadSnapshot,
+    );
+    let origin = app.chat_widget.thread_id();
+    let home = app.chat_widget.config_ref().codex_home.clone();
+    let script = home.join("synthetic-editor.sh");
+    std::fs::write(
+        &script,
+        r##"set -eu
+grep -q 'Which color?' "$1"
+grep -q 'Which size?' "$1"
+awk '
+/^<!-- BEGIN REPLY / { print; printf "blue\nlarge  "; skip=1; next }
+/^<!-- END REPLY / { printf "\n"; skip=0 }
+!skip { print }
+' "$1" > "$1.new"
+mv "$1.new" "$1"
+"##,
+    )?;
+    let _restore = RestoreVisual(std::env::var_os("VISUAL"));
+    // The command uses the native resolver; no editor or owner settings are changed.
+    unsafe {
+        std::env::set_var(
+            "VISUAL",
+            format!("sh {}", shlex::try_quote(script.to_str().unwrap()).unwrap()),
+        )
+    };
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.chat_widget.apply_external_edit("existing draft".into());
+    while operations.try_recv().is_ok() {}
+    app.launch_external_editor(&mut tui).await;
+    assert_eq!(
+        app.chat_widget.composer_text_with_pending(),
+        "blue\nlarge  "
+    );
+    assert_eq!(app.chat_widget.thread_id(), origin);
+    assert!(
+        operations.try_recv().is_err(),
+        "editor must never submit a turn"
+    );
+
+    // A missing boundary must not import any part of the editor document.
+    std::fs::write(&script, "printf 'recoverable edit' > \"$1\"\n")?;
+    while events.try_recv().is_ok() {}
+    app.launch_external_editor(&mut tui).await;
+    assert_eq!(
+        app.chat_widget.composer_text_with_pending(),
+        "blue\nlarge  "
+    );
+    assert!(operations.try_recv().is_err());
+    let retained = std::fs::read_dir(home.join("editor"))?
+        .next()
+        .expect("retained buffer")?
+        .path();
+    assert_eq!(std::fs::read_to_string(&retained)?, "recoverable edit");
+    assert!(
+        std::iter::from_fn(|| events.try_recv().ok()).any(|event| match event {
+            AppEvent::InsertHistoryCell(cell) => lines_to_single_string(&cell.display_lines(500))
+                .contains(retained.to_str().unwrap()),
+            _ => false,
+        })
+    );
+    Ok(())
+}
