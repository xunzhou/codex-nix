+#[tokio::test]
+#[cfg(unix)]
+async fn external_editor_reference_synthetic_questions_to_reply() {
+    let paths = EditorPaths::new();
+    let script = paths.cwd.join("answer.sh");
+    codex_utils_cargo_bin::write_executable(
+        &script,
+        r##"#!/bin/sh
+set -eu
+grep -q 'Which color?' "$1"
+grep -q 'Which size?' "$1"
+grep -q 'existing draft' "$1"
+awk '
+/^<!-- BEGIN REPLY / { print; printf "blue\nlarge  "; skip=1; next }
+/^<!-- END REPLY / { printf "\n"; skip=0 }
+!skip { print }
+' "$1" > "$1.new"
+mv "$1.new" "$1"
+"##,
+    )
+    .unwrap();
+    let reply = super::run_editor_with_reference(
+        "existing draft",
+        Some("Which color?\nWhich size?"),
+        &["sh".into(), script.to_string_lossy().into_owned()],
+        &paths.codex_home,
+        &FileSystemSandboxPolicy::read_only(),
+        &paths.cwd,
+    )
+    .await
+    .unwrap();
+    assert_eq!(reply, "blue\nlarge  ");
+    assert_eq!(
+        fs::read_dir(paths.codex_home.join("editor"))
+            .unwrap()
+            .count(),
+        0
+    );
