diff --git a/codex-rs/tui/src/chatwidget/slash_dispatch.rs b/codex-rs/tui/src/chatwidget/slash_dispatch.rs
index af4a664..a02e2da 100644
--- a/codex-rs/tui/src/chatwidget/slash_dispatch.rs
+++ b/codex-rs/tui/src/chatwidget/slash_dispatch.rs
@@ -41,6 +41,47 @@ const RAW_USAGE: &str = "Usage: /raw [on|off]";
 const USAGE_CHATGPT_LOGIN_REQUIRED: &str = "Sign in with ChatGPT to use /usage.";
 
 impl ChatWidget {
+    pub(super) fn handle_model_shortcut(&mut self, key_event: KeyEvent) -> bool {
+        let reverse = self.chat_keymap.previous_model.is_pressed(key_event);
+        if (!reverse && !self.chat_keymap.next_model.is_pressed(key_event))
+            || !self.bottom_pane.no_modal_or_popup_active()
+        {
+            return false;
+        }
+        if self.blocks_direct_input {
+            self.add_error_message(PARENT_OWNED_INPUT_MESSAGE.to_string());
+            return true;
+        }
+        if !self.ensure_slash_command_allowed_in_side_conversation(SlashCommand::Model) {
+            return true;
+        }
+        if self.slash_command_blocked_by_active_task(SlashCommand::Model, SlashCommandDispatchSource::Live) {
+            self.add_error_message("Model switching is disabled while a task is in progress.".to_string());
+            return true;
+        }
+
+        let current = self.current_model();
+        let mut choices = self.model_catalog.models.iter().filter(|m| m.show_in_picker);
+        let next = if reverse {
+            let last = choices.clone().next_back();
+            choices.rfind(|m| m.model == current).and_then(|_| choices.next_back()).or(last)
+        } else {
+            let first = choices.clone().next();
+            choices.find(|m| m.model == current).and_then(|_| choices.next()).or(first)
+        };
+        if let Some(model) = next {
+            if model.model != current {
+                let slug = model.model.clone();
+                self.handle_model_command_args(&slug);
+                self.app_event_tx.send(AppEvent::SettingsSelectionClosed);
+            }
+        } else {
+            self.add_info_message("No models available to cycle through.".to_string(), None);
+        }
+        true
+    }
+
+
