+                .file_system_sandbox_policy()
+                .can_write_local_path_with_cwd(root.as_path(), config.cwd().as_path())
+        );
+        let saved = config.restorable_thread_settings(config.environments.clone());
+        assert!(!saved.runtime_workspace_roots.unwrap().contains(&root));
+        assert!(
+            !saved.environments.unwrap().environment_requests[0]
+                .workspace_roots
+                .contains(&PathUri::from_abs_path(&root))
+        );
+    }
