+#[tokio::test]
+async fn add_dir_grant_refreshes_context_and_expires_on_cold_resume() -> Result<()> {
+    let server = create_mock_responses_server_sequence_unchecked(vec![
+        create_final_assistant_message_sse_response("before grant")?,
+        create_final_assistant_message_sse_response("after grant")?,
+        create_final_assistant_message_sse_response("after resume")?,
+    ])
+    .await;
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), &server.uri())?;
+    let config_path = home.path().join("config.toml");
+    std::fs::write(
+        &config_path,
+        format!(
+            "{}\n[sandbox_workspace_write]\nexclude_slash_tmp = true\nexclude_tmpdir_env_var = true\n",
+            std::fs::read_to_string(&config_path)?,
+        ),
+    )?;
+
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = mcp
+        .start_thread(ThreadStartParams {
+            model: Some("mock-model".to_string()),
+            sandbox: Some(SandboxMode::WorkspaceWrite),
+            ..Default::default()
+        })
+        .await?;
+    let id = started.thread.id;
+    mcp.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: id.clone(),
+        input: vec![V2UserInput::Text {
+            text: "before".to_string(),
+            text_elements: vec![],
+        }],
+        ..Default::default()
+    })
+    .await?;
+    let directory = TempDir::new()?;
+    let root = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(
+        std::fs::canonicalize(directory.path())?,
+    )?;
+    let config_before = std::fs::read(home.path().join("config.toml"))?;
+    let request = mcp
+        .send_raw_request(
+            "thread/settings/update",
+            Some(json!({
+                "threadId": id, "addWritableRoot": root,
+            })),
+        )
+        .await?;
+    let granted: ThreadSettingsUpdateResponse = mcp.read_response(request).await?;
+    assert_eq!(granted.granted_writable_root.as_ref(), Some(&root));
+    let updated = read_thread_settings_updated(&mut mcp).await?;
+    assert!(
+        matches!(&updated.thread_settings.sandbox_policy, SandboxPolicy::WorkspaceWrite { writable_roots, .. }
+        if writable_roots.iter().any(|path| path.as_path() == root.as_path()))
+    );
+    assert_eq!(
+        std::fs::read(home.path().join("config.toml"))?,
+        config_before
+    );
+    let mut client_roots = started.runtime_workspace_roots.clone();
+    client_roots.push(root.clone());
+    mcp.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: id.clone(),
+        runtime_workspace_roots: Some(client_roots),
+        input: vec![V2UserInput::Text {
+            text: "use the grant".to_string(),
+            text_elements: vec![],
+        }],
+        ..Default::default()
+    })
+    .await?;
+    let warm_id = mcp
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let warm: ThreadResumeResponse = mcp.read_response(warm_id).await?;
+    assert!(warm.runtime_workspace_roots.contains(&root));
+    // Restart the app-server to exercise persisted settings rather than its in-memory cache.
+    drop(mcp);
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let resume_id = mcp
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let resumed: ThreadResumeResponse = mcp.read_response(resume_id).await?;
+    assert!(!resumed.runtime_workspace_roots.contains(&root));
+    mcp.start_turn_and_wait_for_completion(TurnStartParams {
+        thread_id: id,
+        input: vec![V2UserInput::Text {
+            text: "after".to_string(),
+            text_elements: vec![],
+        }],
+        ..Default::default()
+    })
+    .await?;
+    let bodies = received_response_bodies(&server).await?;
+    assert!(!bodies[0].to_string().contains(&root.display().to_string()));
+    let last_environment = |body: &Value| -> String {
+        body["input"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .flat_map(|item| item["content"].as_array().into_iter().flatten())
+            .filter_map(|item| item["text"].as_str())
+            .filter(|text| text.contains("<environment_context>"))
+            .last()
+            .unwrap()
+            .to_string()
