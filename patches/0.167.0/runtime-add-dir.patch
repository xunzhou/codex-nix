+impl ChatWidget {
+    pub(crate) fn apply_confirmed_writable_root(&mut self, root: &AbsolutePathBuf) {
+        if !self.config.workspace_roots.contains(root) {
+            self.config.workspace_roots.push(root.clone());
+        }
+        self.config
+            .permissions
+            .set_workspace_roots(self.config.workspace_roots.clone());
+    }
+
+    pub(super) fn request_add_directory(&mut self, path: &str) {
+        if path.trim().is_empty() {
+            self.add_error_message("Usage: /add-dir <path>".to_string());
+            return;
+        }
+        let Some(thread_id) = self.thread_id else {
+            self.add_error_message("Start a session before using /add-dir.".to_string());
+            return;
+        };
+        if self.active_side_conversation
+            || self.blocks_direct_input
+            || !self.local_worktree_operations
+        {
+            self.add_error_message(
+                "/add-dir requires a local primary session with direct input enabled.".to_string(),
+            );
+            return;
+        }
+        let requested = self.config.cwd.as_path().join(path);
+        let root = match std::fs::canonicalize(&requested) {
+            Ok(root) if root.is_dir() => match AbsolutePathBuf::from_absolute_path(root) {
+                Ok(root) => root,
+                Err(err) => {
+                    self.add_error_message(format!("Cannot resolve directory: {err}"));
+                    return;
+                }
+            },
+            Ok(_) => {
+                self.add_error_message(format!("Not a directory: {}", requested.display()));
+                return;
+            }
+            Err(err) => {
+                self.add_error_message(format!(
+                    "Cannot access directory {}: {err}",
+                    requested.display()
+                ));
+                return;
+            }
+        };
+        if self
+            .config
+            .permissions
+            .permission_profile()
+            .file_system_sandbox_policy()
+            .materialize_project_roots_with_workspace_roots(&self.config.workspace_roots)
+            .can_write_local_path_with_cwd(root.as_path(), self.config.cwd.as_path())
+        {
+            self.add_info_message(
+                format!("Directory is already writable: {}", root.display()),
+                None,
+            );
+            return;
+        }
+        let source_cwd = self.config.cwd.clone();
+        self.bottom_pane.show_selection_view(SelectionViewParams {
+            title: Some("Grant directory write access?".to_string()),
+            subtitle: Some(root.display().to_string()),
+            items: vec![
+                SelectionItem {
+                    name: "Cancel".to_string(),
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+                SelectionItem {
+                    name: "Grant write access to this directory".to_string(),
+                    description: Some("This running session only; not saved for cold resume. Existing protections and managed policy still apply.".to_string()),
+                    actions: vec![Box::new(move |tx| tx.send(AppEvent::AddWritableRoot {
+                        thread_id, source_cwd: source_cwd.clone(), root: root.clone(),
+                    }))],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                },
+            ],
+            initial_selected_idx: Some(0),
+            footer_note: Some("Applies from the next turn. Already-running processes retain their original sandbox permissions.".into()),
+            ..SelectionViewParams::picker()
+        });
+    }
+}
