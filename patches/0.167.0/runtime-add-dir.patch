+// This must exercise the OS sandbox, not just the permission evaluator: the TUI
+// supplies its cached runtime roots on every turn, including the first after a grant.
+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn add_dir_grant_allows_sandbox_write_with_next_turn_client_overrides() -> Result<()> {
+    use codex_features::Feature;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    let server = responses::start_mock_server().await;
+    let home = TempDir::new()?;
+    let extra = TempDir::new()?;
+    let unrelated = TempDir::new()?;
+    let root = AbsolutePathBuf::from_absolute_path(extra.path().canonicalize()?)?;
+    std::fs::create_dir(extra.path().join(".git"))?;
+    MockResponsesConfig::new(&server.uri())
+        .with_sandbox_mode("workspace-write")
+        .with_approval_policy("never")
+        .enable_feature(Feature::UnifiedExec)
+        .disable_feature(Feature::ShellSnapshot)
+        .disable_feature(Feature::CodeMode)
+        .with_extra_config(
+            "[sandbox_workspace_write]\nexclude_slash_tmp = true\nexclude_tmpdir_env_var = true",
+        )
+        .write(home.path())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = app.start_thread(ThreadStartParams::default()).await?;
+    let mut roots = started.runtime_workspace_roots.clone();
+    for (index, command, expected_exit) in [
+        (
+            0,
+            format!("printf probe > '{}'", extra.path().join("probe").display()),
+            1,
+        ),
+        (
+            1,
+            format!("printf probe > '{}'", extra.path().join("probe").display()),
+            0,
+        ),
+        (
+            2,
+            format!(
+                "printf blocked > '{}'",
+                extra.path().join(".git/probe").display()
+            ),
+            1,
+        ),
+        (
+            3,
+            format!(
+                "printf blocked > '{}'",
+                unrelated.path().join("probe").display()
+            ),
+            1,
+        ),
+    ] {
+        if index == 1 {
+            let response: ThreadSettingsUpdateResponse = app
+                .request(|request_id| ClientRequest::ThreadSettingsUpdate {
+                    request_id,
+                    params: ThreadSettingsUpdateParams {
+                        thread_id: started.thread.id.clone(),
+                        add_writable_root: Some(root.clone()),
+                        ..Default::default()
+                    },
+                })
+                .await?;
+            assert_eq!(response.granted_writable_root.as_ref(), Some(&root));
+            // Same cache adoption as the TUI after server acknowledgement.
+            roots.push(root.clone());
+        }
+        let call_id = format!("probe-{index}");
+        responses::mount_sse_once(
+            &server,
+            responses::sse(vec![
+                responses::ev_response_created("command"),
+                responses::ev_function_call(
+                    &call_id,
+                    "exec_command",
+                    &json!({"cmd": command, "yield_time_ms": 1000}).to_string(),
+                ),
+                responses::ev_completed("command"),
+            ]),
+        )
+        .await;
+        let continuation = responses::mount_sse_once(
+            &server,
+            create_final_assistant_message_sse_response("done")?,
+        )
+        .await;
+        app.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: started.thread.id.clone(),
+            // Reproduce client-owned local TUI settings rather than a bare API turn.
+            cwd: Some(started.cwd.to_path_buf()),
+            runtime_workspace_roots: Some(roots.clone()),
+            sandbox_policy: Some(started.sandbox.clone()),
+            approval_policy: Some(AskForApproval::Never),
+            input: vec![V2UserInput::Text {
+                text: "Run the write probe".into(),
+                text_elements: vec![],
+            }],
+            ..Default::default()
+        })
+        .await?;
+        let request = continuation.single_request();
+        let output = request
+            .function_call_output_text(&call_id)
+            .context("model must receive sandbox command result")?;
+        if index == 1 {
+            let body = request.body_json();
+            let environment = body["input"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .flat_map(|item| item["content"].as_array().into_iter().flatten())
+                .filter_map(|item| item["text"].as_str())
+                .filter(|text| text.contains("<environment_context>"))
+                .last()
+                .context("next turn must refresh model environment")?;
+            assert!(environment.contains(&format!(
+                "<entry access=\"write\"><path>{}</path>",
+                root.display()
+            )));
+        }
+        assert!(
+            output.contains(&format!("Process exited with code {expected_exit}")),
+            "{output}"
+        );
+        assert_eq!(extra.path().join("probe").exists(), index > 0);
+        assert!(!extra.path().join(".git/probe").exists());
+        assert!(!unrelated.path().join("probe").exists());
+    }
+    assert_eq!(
+        std::fs::read_to_string(extra.path().join("probe"))?,
+        "probe"
+    );
+    app.shutdown_gracefully().await?;
+    Ok(())
+}
