+    let granted_context = last_environment(&bodies[1]);
+    assert!(granted_context.contains(&format!(
+        "<entry access=\"write\"><path>{}</path>",
+        root.display()
+    )));
+    assert!(!last_environment(&bodies[2]).contains(&root.display().to_string()));
+    Ok(())
