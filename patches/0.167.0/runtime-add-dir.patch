+async fn add_dir_acknowledged_grant_updates_next_turn_and_cached_roots() -> Result<()> {
+    let (mut app, _events, _ops) = make_test_app_with_channels().await;
+    let home = tempfile::tempdir()?;
+    let workspace = tempfile::tempdir()?;
+    let extra = tempfile::tempdir()?;
+    app.config.codex_home = home.path().to_path_buf().abs();
+    app.config.sqlite = codex_state::SqliteConfig::new_for_testing(home.path().abs());
+    app.config.cwd = workspace.path().canonicalize()?.abs();
+    app.config.workspace_roots = vec![app.config.cwd.clone()];
+    app.config
+        .permissions
+        .set_workspace_roots(app.config.workspace_roots.clone());
+    app.config
+        .permissions
+        .set_permission_profile(PermissionProfile::workspace_write())?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let started = server.start_thread(&app.config).await?;
+    let thread_id = started.session.thread_id;
+    app.enqueue_primary_thread_session(started.session, started.turns)
+        .await?;
+    let root = extra.path().canonicalize()?.abs();
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    // Exercise the confirmation event and acknowledgement, not just a standalone
+    // server update: the next turn is built from the widget's permission roots.
+    for _ in 0..2 {
+        app.handle_event(
+            &mut tui,
+            &mut server,
+            AppEvent::AddWritableRoot {
+                thread_id,
+                source_cwd: app.config.cwd.clone(),
+                root: root.clone(),
+            },
+        )
+        .await?;
+        for roots in [
+            app.config.workspace_roots.as_slice(),
+            app.chat_widget.config_ref().workspace_roots.as_slice(),
+            app.chat_widget
+                .config_ref()
+                .permissions
+                .user_visible_workspace_roots(),
+            &app.primary_session_configured
+                .as_ref()
+                .unwrap()
+                .runtime_workspace_roots,
+        ] {
+            assert_eq!(roots.iter().filter(|path| *path == &root).count(), 1);
+            assert!(roots.contains(&app.config.cwd));
+        }
+        let store = app.thread_event_channels[&thread_id].store.lock().await;
+        assert!(
+            store
+                .session
+                .as_ref()
+                .unwrap()
+                .runtime_workspace_roots
+                .contains(&root)
+        );
