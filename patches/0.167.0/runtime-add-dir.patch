new file mode 100644
index 0000000000000000000000000000000000000000..d04f65aafbbb3a4be460b531d7ee6a84644a10b3
--- /dev/null
+++ b/codex-rs/core/src/session/runtime_add_dir.rs
@@ -0,0 +1,334 @@
+//! Additive, thread-scoped workspace grants. Never replaces a permission profile.
+
+use super::session::Session;
+use super::session::SessionConfiguration;
+use super::session::SessionSettingsUpdate;
+use super::thread_settings;
+use crate::config::ConstraintError;
+use crate::config::ConstraintResult;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::permissions::FileSystemPath;
+use codex_protocol::permissions::FileSystemSpecialPath;
+use codex_protocol::permissions::is_protected_metadata_name;
+use codex_protocol::protocol::EnvironmentConfigState;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+
+fn denied(root: &AbsolutePathBuf, reason: impl std::fmt::Display) -> ConstraintError {
+    ConstraintError::InvalidValue {
+        field_name: "add_writable_root",
+        candidate: root.display().to_string(),
+        allowed: reason.to_string(),
+        requirement_source: codex_config::RequirementSource::Unknown,
+    }
+}
+
+impl SessionConfiguration {
+    pub(super) fn add_writable_root(&mut self, root: &AbsolutePathBuf) -> ConstraintResult<()> {
+        // Revalidate at commit, including the identity the user saw in the prompt.
+        let canonical = std::fs::canonicalize(root.as_path())
+            .map_err(|err| denied(root, format!("an accessible existing directory ({err})")))?;
+        if canonical != root.as_path() || !canonical.is_dir() {
+            return Err(denied(
+                root,
+                "an unchanged canonical directory; run /add-dir again",
+            ));
+        }
+        if root
+            .as_path()
+            .components()
+            .any(|part| is_protected_metadata_name(part.as_os_str()))
+        {
+            return Err(denied(root, "a directory outside protected metadata paths"));
+        }
+        if self.environments.is_empty()
+            || self.environments.iter().any(|env| {
+                env.environment_id != codex_exec_server::LOCAL_ENVIRONMENT_ID
+                    || env.config != EnvironmentConfigState::FromThread
+            })
+        {
+            return Err(denied(
+                root,
+                "a local environment with thread-owned permissions",
+            ));
+        }
+        let profile = self.permission_profile();
+        let policy = profile.file_system_sandbox_policy();
+        // An explicit profile must permit writes to workspace roots. Do not silently
+        // turn read-only or path-limited profiles into workspace-write profiles.
+        let symbolic = policy.entries.iter().any(|entry| {
+            entry.access.can_write()
+                && matches!(
+                    entry.path,
+                    FileSystemPath::Special {
+                        value: FileSystemSpecialPath::ProjectRoots { subpath: None }
+                    }
+                )
+        });
+        if !symbolic {
+            return Err(denied(
+                root,
+                "a permission profile that allows workspace-root writes",
+            ));
+        }
+        let current_policy = self.file_system_sandbox_policy(&self.environments);
+        if self.runtime_workspace_roots.contains(root) {
+            return if current_policy
+                .can_read_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+                && current_policy
+                    .can_write_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+            {
+                Ok(())
+            } else {
+                Err(denied(
+                    root,
+                    "a directory allowed by the current filesystem policy",
+                ))
+            };
+        }
+
+        for entry in &current_policy.entries {
+            if !entry.access.can_write()
+                && let FileSystemPath::Path { path } = &entry.path
+                && let Ok(path) = path.to_abs_path()
+                && root.as_path().starts_with(
+                    std::fs::canonicalize(path.as_path()).unwrap_or_else(|_| path.to_path_buf()),
+                )
+            {
+                return Err(denied(
+                    root,
+                    format!("a directory outside restricted path {}", path.display()),
+                ));
+            }
+        }
+        let mut roots = self.runtime_workspace_roots.clone();
+        roots.push(root.clone());
+        // Validate the expanded policy with existing managed-policy validators. Keep
+        // the symbolic profile, its ID, network rules, and every carveout intact.
+        let candidate = profile
+            .clone()
+            .materialize_project_roots_with_workspace_roots(&roots);
+        self.permission_profile_state
+            .can_set_legacy_permission_profile(&candidate)?;
+        let candidate_policy = candidate.file_system_sandbox_policy();
+        if !candidate_policy.can_read_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+            || !candidate_policy.can_write_local_path_with_cwd(root.as_path(), self.cwd().as_path())
+        {
+            return Err(denied(
+                root,
+                "a directory allowed by the current filesystem policy",
+            ));
+        }
+        let uri = PathUri::from_abs_path(root);
+        for environment in &mut self.environments {
+            if !environment.workspace_roots.contains(&uri) {
+                environment.workspace_roots.push(uri.clone());
+            }
+        }
+        self.runtime_workspace_roots = roots;
+        self.session_granted_roots.push(root.clone());
+        Ok(())
+    }
+}
+
+impl Session {
+    pub(crate) async fn add_writable_root(&self, root: AbsolutePathBuf) -> CodexResult<()> {
+        let _guard = thread_settings::acquire_persistence_lock(self).await;
+        let commit = self
+            .update_settings(SessionSettingsUpdate {
+                add_writable_root: Some(root),
+                ..Default::default()
+            })
+            .await
+            .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+        // Grant roots are omitted from every persistent checkpoint. The event still
+        // refreshes live client settings; the next turn captures the updated roots.
+        thread_settings::emit_applied(self, super::new_submission_id(), commit.snapshot).await;
+        Ok(())
+    }
+}
