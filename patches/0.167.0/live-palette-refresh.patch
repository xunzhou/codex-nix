+// Defer syntax refresh to the app so current session preferences are respected.
+#[cfg(not(test))]
+static SYNTAX_THEME_REFRESH_PENDING: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+#[cfg(test)]
+thread_local! {
+    static SYNTAX_THEME_REFRESH_PENDING: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+pub(crate) fn request_syntax_theme_refresh() {
+    #[cfg(not(test))]
+    SYNTAX_THEME_REFRESH_PENDING.store(true, std::sync::atomic::Ordering::Release);
+    #[cfg(test)]
+    SYNTAX_THEME_REFRESH_PENDING.with(|pending| pending.set(true));
+}
+
+pub(crate) fn take_syntax_theme_refresh() -> bool {
+    #[cfg(not(test))]
+    {
+        SYNTAX_THEME_REFRESH_PENDING.swap(false, std::sync::atomic::Ordering::AcqRel)
+    }
+    #[cfg(test)]
+    SYNTAX_THEME_REFRESH_PENDING.with(|pending| pending.replace(false))
+}
+
+#[cfg(unix)]
+pub(crate) fn refresh_default_colors_from_terminal() -> bool {
+    let Ok(probe) = crate::terminal_probe::startup(
+        crate::terminal_probe::DEFAULT_TIMEOUT,
+        crate::terminal_probe::StartupKeyboardEnhancementProbe::Skip,
+    ) else {
+        return false;
+    };
+    let Some(colors) = probe.default_colors else {
+        return false;
+    };
+    imp::set_default_colors_from_startup_probe(Some(colors));
+    request_syntax_theme_refresh();
+    true
+}
